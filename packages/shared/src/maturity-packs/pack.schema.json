{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmdash.net/schemas/maturity-pack.schema.json",
  "title": "CMDash Maturity Content Pack",
  "description": "Content-pack format defined by docs/design/maturity-engine.md #4. One MaturityModel plus its ordinal MaturityLevel ladder and MaturityDimension list, with pack-relative control mappings resolved by the loader at install time.",
  "type": "object",
  "additionalProperties": false,
  "required": ["packFormatVersion", "model", "levels", "dimensions"],
  "properties": {
    "packFormatVersion": {
      "type": "integer",
      "const": 1,
      "description": "JSON-shape version. Bumped only for a code-level migration of the pack format itself."
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "name", "version", "minOrdinal", "maxOrdinal", "provenance"],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Stable identity across pack versions (MaturityModel.slug)."
        },
        "name": { "type": "string", "minLength": 1 },
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "Pack content version, e.g. \"2.0\". Compared with the installed pack on upgrade."
        },
        "description": { "type": ["string", "null"], "default": null },
        "minOrdinal": {
          "type": "integer",
          "description": "Lowest ordinal on the model's ladder (0 for C2M2 MIL0, 1 for CSF tiers)."
        },
        "maxOrdinal": {
          "type": "integer",
          "description": "Highest ordinal on the model's ladder. Must be > minOrdinal."
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["publisher", "sourceDoc", "sourceUrl", "license"],
          "description": "Mandatory per docs/design/maturity-engine.md #4 — shown pre-adopt.",
          "properties": {
            "publisher": { "type": "string", "minLength": 1 },
            "sourceDoc": { "type": "string", "minLength": 1 },
            "sourceUrl": {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            },
            "license": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ordinal", "key", "name"],
        "properties": {
          "ordinal": {
            "type": "integer",
            "description": "Must be unique within the pack and within [model.minOrdinal, model.maxOrdinal]."
          },
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "Stable pack key, e.g. \"tier-1\", \"ig1\", \"mil0\". Unique among levels."
          },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": ["string", "null"], "default": null }
        }
      }
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "name", "controlMappings"],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "Stable pack key, e.g. \"govern\", \"access-control\". Unique among dimensions."
          },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": ["string", "null"], "default": null },
          "domain": {
            "type": ["string", "null"],
            "default": null,
            "description": "Optional grouping (e.g. CSF function bucket)."
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 1.0
          },
          "sortOrder": { "type": "integer", "default": 0 },
          "levelDescriptors": {
            "type": ["object", "null"],
            "default": null,
            "description": "Optional per-dimension level-language override, keyed by level key."
          },
          "controlMappings": {
            "type": "array",
            "description": "Pack-declared dimension -> control references, resolved to Control.id at install. Unresolved frameworkSlug/controlKey is a loader warning, not a hard failure.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["frameworkSlug", "controlKey"],
              "properties": {
                "frameworkSlug": { "type": "string", "minLength": 1 },
                "controlKey": { "type": "string", "minLength": 1 },
                "weight": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "default": 1.0
                }
              }
            }
          },
          "previousKeys": {
            "type": "array",
            "default": [],
            "description": "Renamed-key aliases honored on upgrade so tenant assessments re-point by key.",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          }
        }
      }
    }
  }
}
