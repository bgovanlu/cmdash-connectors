{
  "packFormatVersion": 1,
  "model": {
    "slug": "cis-controls-ig",
    "name": "CIS Controls v8.1 Implementation Groups",
    "version": "8.1",
    "description": "Maturity model built from the CIS Critical Security Controls v8.1 Implementation Group (IG) ladder. Levels are CIS's own IG1/IG2/IG3 tiers (cumulative Safeguard sets: 56 / 130 / 153 of 153 total Safeguards). Dimensions are the 18 CIS Controls themselves, reshaped from CIS's Control-then-Safeguard-then-IG structure into this engine's model-ladder/dimension-list shape (per docs/design/maturity-engine.md #4 and scripts/maturity/author-pack.md #3.3): each dimension's ordinal reflects overall Safeguard-implementation depth for that Control, derived from crosswalk seeding against every seeded Safeguard under that Control number in the built-in \"cis-controls\" (CIS Controls v8) framework. This pack does not encode which individual Safeguards CIS itself assigns to IG1 vs IG2 vs IG3 — that per-Safeguard granularity is not present in the seeded framework and is not fabricated here; consult CIS's own IG worksheet for exact per-Safeguard IG assignment.",
    "minOrdinal": 1,
    "maxOrdinal": 3,
    "provenance": {
      "publisher": "Center for Internet Security",
      "sourceDoc": "CIS Critical Security Controls v8.1",
      "sourceUrl": "https://www.cisecurity.org/controls",
      "license": "CIS terms of use (free use with attribution)"
    }
  },
  "levels": [
    {
      "ordinal": 1,
      "key": "ig1",
      "name": "IG1: Essential Cyber Hygiene",
      "description": "The foundational set of 56 of the 153 total CIS Safeguards, designated by CIS as essential cyber hygiene: an emerging minimum standard of information security that CIS recommends for every enterprise regardless of sector or size. IG1 Safeguards are generally implementable with limited in-house cybersecurity expertise, using largely off-the-shelf hardware and software, and are aimed at thwarting general, non-targeted attacks. IG1 is the on-ramp to the CIS Controls."
    },
    {
      "ordinal": 2,
      "key": "ig2",
      "name": "IG2: Implementation Group 2",
      "description": "Builds on IG1 with 74 additional Safeguards (130 cumulative of 153). CIS aims IG2 at enterprises with more resources and greater IT complexity — typically multiple departments with differing risk profiles, staff dedicated to managing and protecting IT infrastructure, and responsibility for sensitive client or organizational data. IG2 Safeguards help security teams cope with increased operational complexity and often assume more technical expertise to plan and execute than IG1."
    },
    {
      "ordinal": 3,
      "key": "ig3",
      "name": "IG3: Implementation Group 3",
      "description": "The complete set of all 153 CIS Safeguards, adding 23 more beyond IG2's 130. CIS aims IG3 at mature enterprises with dedicated security staff whose Safeguards must reduce the impact of sophisticated, targeted attacks and address the availability of critical services as well as the confidentiality and integrity of sensitive data. IG3 Safeguards frequently require specialized skills and coordination to design, implement, and operate."
    }
  ],
